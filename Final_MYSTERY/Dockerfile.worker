FROM golang:1.24 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -trimpath -o /worker ./cmd/worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /worker /worker
ENTRYPOINT ["/worker"]
